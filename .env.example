REDACTION_SERVICE_API_KEY=dev-secret
LOG_LEVEL=INFO
MAX_PDF_MB=10
MAX_PAGES=30
REQUEST_TIMEOUT_SECONDS=30
PORT=8080
# Set to true to enable [redactor]/[verify] and extracted-text logs (disable in production)
ENABLE_DEBUG_REDACTION_LOGS=false

# Extraction subsystem
MAX_EXTRACT_PDF_MB=50
MAX_EXTRACT_PAGES=500
EXTRACT_FETCH_TIMEOUT_SECONDS=60
EXTRACT_PROCESS_TIMEOUT_SECONDS=120
ENABLE_DEBUG_EXTRACTION_LOGS=false
